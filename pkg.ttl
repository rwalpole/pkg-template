prefix dbpedia: <http://dbpedia.org/resource/>
prefix dcterms: <http://purl.org/dc/terms/>
prefix foaf: <http://xmlns.com/foaf/0.1/>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix schema: <http://schema.org/>
prefix vcard: <http://www.w3.org/2006/vcard/ns#>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>

@base <http://xmlsummerschool.org/entity> .

<#Rob_Walpole> a schema:Person , vcard:Individual ;
    schema:name "Rob Walpole" ;
    rdfs:label "Rob Walpole" ;
    vcard:given-name "Robert" ;
    foaf:givenName "Robert" ;
    vcard:nickname "Rob" ;
    foaf:nick "Rob" ;
    vcard:family-name "Walpole" ;
    foaf:familyName "Walpole" ;
    schema:email "rob.walpole@devexe.co.uk" ;
    vcard:hasEmail <mailto:rob.walpole@devexe.co.uk> ;
    schema:sameAs <https://x.com/rkw01> ,  <https://www.linkedin.com/in/robwalpole/> .

<#Mohamed_Zergaoui> a schema:Person ;
    schema:name "Mohamed Zergaoui" ;
    rdfs:label "Mohamed Zergaoui" .

<#Peter_Winstanley> a schema:Person ;
    schema:name "Peter Winstanley" ;
    rdfs:label "Peter Winstanley" .

<#XML_Summer_School,_2026> a schema:Event ;
    schema:name "XML Summer School, 2026" ;
    rdfs:label "XML Summer School, 2026" ;
    schema:startDate "2026-09-13"^^xsd:date ;
    schema:endDate "2026-09-18"^^xsd:date ;
    schema:location <http://dbpedia.org/resource/St_Edmund_Hall,_Oxford> ;
    schema:description "An intensive summer school focused on XML technologies and applications." ;
    dcterms:hasPart <#Linked_Data_and_Semantic_XML> ;
    schema:attendee <#???> .

<#Linked_Data_and_Semantic_XML> a schema:Course ;
    schema:name "Linked Data and Semantic XML" ;
    rdfs:label "Linked Data and Semantic XML" ;
    schema:description "A course on Linked Data and Semantic XML, exploring the integration of XML with semantic web technologies." ;
    schema:hasCourseInstance
        <#RDF_101> ,
        <#GET_the_Data> ,
        <#OWL_Data_Modelling> ,
        <#RDF_Shapes_and_SHACL_for_Validation> ,
        <#Building_a_Personal_Knowledge_Graph> ,
        <#RDF_Emerging_Technologies> ,
        <#Questions_and_Answers_with_the_Experts> .

<#RDF_101> a schema:CourseInstance ;
    schema:name "RDF 101 – Representing Knowledge, Graph Models, URI Identifiers, Visualisation, Intro to Triples (TTL)" ;
    schema:description "A foundational session introducing knowledge representation using graphs and triples, the role of URIs as unique identifiers, RDF fundamentals, the Semantic Web technology stack, and linked data principles." ;
    schema:instructor <#Rob_Walpole> ;
    schema:about dbpedia:Resource_Description_Framework ;
    schema:attendee <#???> .

<#GET_the_Data> a schema:CourseInstance ;
    schema:name "GET the Data: An introduction to SPARQL" ;
    schema:description "Examines SPARQL as a query language for accessing RDF data, plus the protocol for retrieving results over HTTP." ;
    schema:about dbpedia:SPARQL ;
    schema:instructor <#Peter_Winstanley> ;
    schema:attendee <#???> .

<#OWL_Data_Modelling> a schema:CourseInstance ;
    schema:name "OWL Data Modelling" ;
    schema:description "An in-depth introduction to OWL, covering domain modelling through classes, properties and logical axioms, with an emphasis on ontology design best practices and consistency validation." ;
    schema:instructor <#Mohamed_Zergaoui> ;
    schema:about dbpedia:Web_Ontology_Language ;
    schema:attendee <#???> .

<#RDF_Shapes_and_SHACL_for_Validation> a schema:CourseInstance ;
    schema:name "RDF Shapes and SHACL for Validation" ;
    schema:description "Introduces the SHACL language for validating RDF data, focusing on writing shapes to ensure data quality, detect inconsistencies, and enforce business rules in linked data." ;
    schema:instructor <#Mohamed_Zergaoui> ;
    schema:about dbpedia:SHACL ;
    schema:attendee <#???> .

<#Building_a_Personal_Knowledge_Graph> a schema:CourseInstance ;
    schema:name "Linked Data Concepts and Applications - Building a Personal Knowledge Graph" ;
    schema:description "A hands-on session applying earlier concepts, where participants build a Personal Knowledge Graph (PKG), learning to design URIs, model data, locate resources, and create vocabularies." ;
    schema:instructor <#Rob_Walpole> ;
    schema:about dbpedia:Knowledge_graph ;
    schema:attendee <#???> .

<#RDF_Emerging_Technologies> a schema:CourseInstance ;
    schema:name "RDF Emerging Technologies" ;
    schema:description "Covers RDF 1.2 reification for provenance and claims disputation, plus emerging SHACL inference rule standards." ;
    schema:instructor <#Peter_Winstanley> ;
    schema:attendee <#???> .

<#Questions_and_Answers_with_the_Experts> a schema:CourseInstance ;
    schema:name "Questions and Answers with the Experts and Advice on your code" ;
    schema:description "An expert panel Q&A session with all Linked Data faculty." ;
    schema:instructor <#Rob_Walpole>, <#Mohamed_Zergaoui>, <#Peter_Winstanley> ;
    schema:attendee <#???> .
